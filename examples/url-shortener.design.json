      "flags": [
        {
          "intent": "Redirect Service keeps click path fast and isolated; click-counting-must-never-slow-redirect with p99<50ms",
          "difference": "handler awaits db UPDATE links SET clicks before res.redirect, putting counting synchronously on redirect hot path instead of async after redirect"
        }
      ]
    },
