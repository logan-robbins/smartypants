      "what": "Serves 100 most viewed videos per window",
      "why": "Product needs hourly daily all-time charts",
      "shape": "service",
      "flags": []
    },
    {
      "id": "viewer-client",
      "name": "Viewer Client",
      "kind": "component",
      "parentId": "yt-topk",
      "what": "Sends views and requests top lists",
      "why": "Outside caller driving reads and writes",
      "shape": "client",
      "flags": []
    },
    {
      "id": "view-ingest",
      "name": "View Ingest",
      "kind": "component",
      "parentId": "yt-topk",
      "what": "Accepts view events",
      "why": "Entry point for count pipeline",
      "shape": "service",
      "flags": []
    },
    {
      "id": "window-counter",
      "name": "Window Counter",
      "kind": "component",
      "parentId": "yt-topk",
      "what": "Counts views per video for hour day all-time",
      "why": "Maintains windowed view totals",
      "shape": "service",
      "flags": []
    },
    {
      "id": "count-store",
      "name": "Count Store",
      "kind": "component",
      "parentId": "yt-topk",
      "what": "Persists per-video window counts",
      "why": "Durable source for ranking",
      "shape": "store",
      "flags": []
    },
    {
      "id": "topk-ranker",
      "name": "Top-K Ranker",
      "kind": "component",
      "parentId": "yt-topk",
      "what": "Computes top 100 per window",
      "why": "Avoids scanning all videos on read",
      "shape": "worker",
      "flags": []
    },
    {
      "id": "topk-cache",
      "name": "Top-K Cache",
      "kind": "component",
      "parentId": "yt-topk",
      "what": "Holds current top-100 hour day all-time",
      "why": "Serves hot charts fast",
      "shape": "cache",
      "flags": []
    },
    {
      "id": "topk-api",
      "name": "Top-K API",
      "kind": "component",
      "parentId": "yt-topk",
      "what": "Returns top 100 for requested window",
      "why": "Read edge for charts feature",
      "shape": "gateway",
      "flags": []
    },
    {
      "id": "view-topic",
      "name": "View Topic",
      "kind": "module",
      "parentId": "view-ingest",
      "what": "Holds view events partitioned by video id",
      "why": "Buffer 50k/s views and keep per-video order",
      "shape": "queue",
      "flags": []
    },
    {
      "id": "sketch-counter",
      "name": "Sketch Counter",
      "kind": "module",
      "parentId": "window-counter",
      "what": "Estimates per-video counts with sketch for hour/day only",
      "why": "Fast approximate counts for sliding windows",
      "shape": "service",
      "notes": [
        "CMS per window: hour/day/alltime, 5 rows x 200k counters, 4B counters",
        "key videoId hashed d=5x, increment O(d) in-memory",
        "sharded by kafka videoId partition, periodic merge to Count Store",
        "flush deltas every 1min, hot-path <2ms at 50k views/s peak",
        "overcount-only error eps~0.001, safe for top-100 threshold",
        "failure: lossy sketch rebuilt from Count Store + topic replay"
      ],
      "flags": []
    },
    {
      "id": "heap-tracker",
      "name": "Heap Tracker",
      "kind": "module",
      "parentId": "topk-ranker",
      "what": "Keeps min-heap of top 100 per hour/day/all-time",
      "why": "Maintain rolling top-100 on 1min interval",
      "shape": "worker",
      "flags": []
    },
    {
      "id": "redis-toplists",
      "name": "Redis Top Lists",
      "kind": "module",
      "parentId": "topk-cache",
      "what": "Stores current top-100 hour day all-time",
      "why": "Serve 10k qps lookups",
      "shape": "cache",
      "flags": []
    },
    {
      "id": "api-router",
      "name": "Window Router",
      "kind": "module",
      "parentId": "topk-api",
      "what": "Validates window param and builds toplist response",
      "why": "Keeps API contract stable across hour/day/all-time",
      "shape": "service",
      "flags": []
    },
    {
      "id": "toplist-loader",
      "name": "Toplist Loader",
      "kind": "module",
      "parentId": "topk-api",
      "what": "Reads current top-100 from Redis Top Lists",
      "why": "Serves 10k qps reads without touching counters",
      "shape": "service",
      "flags": [
        {
          "intent": "Reads current top-100 from Redis Top Lists",
          "difference": "Delivered topK executes SELECT video_id, views FROM counts on Cassandra and sorts in-request instead of reading current top-100 from Redis Top Lists, touching counters on the 10k qps read path."
        }
      ]
    },
    {
      "id": "query-guard",
      "name": "Query Guard",
      "kind": "module",
      "parentId": "topk-api",
      "what": "Rate-limits and authenticates top-K queries",
      "why": "Protects cache and ranker from query spikes",
      "shape": "service",
      "flags": []
    },
    {
      "id": "cassandra-counters",
      "name": "Cassandra Counters",
      "kind": "module",
      "parentId": "count-store",
      "what": "Exact counter table for all-time per-video views",
      "why": "Keep precise all-time totals without sketch error",
      "shape": "store",
      "flags": []
    },
    {
      "id": "alltime-batch-job",
      "name": "All-Time Batch Job",
      "kind": "module",
      "parentId": "topk-ranker",
      "what": "Hourly scan to rebuild all-time top-100",
      "why": "Recompute accurate all-time list once per hour",
      "shape": "worker",
      "flags": []
    }
  ],
