  "nodes": [
    {
      "id": "fb-newsfeed",
      "name": "Facebook News Feed",
      "kind": "system",
      "parentId": null,
      "what": "Publishes posts and serves ranked feeds",
      "why": "Connect users with friends and pages posts",
      "shape": "service",
      "flags": []
    },
    {
      "id": "edge-gateway",
      "name": "Feed API Gateway",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Routes publish and feed read requests",
      "why": "Single edge entry for feed traffic",
      "shape": "gateway",
      "flags": []
    },
    {
      "id": "post-publisher",
      "name": "Post Publishing Service",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Accepts and validates new posts",
      "why": "Owns post creation path",
      "shape": "service",
      "flags": []
    },
    {
      "id": "social-graph",
      "name": "Social Graph Service",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Stores friends and page follows",
      "why": "Defines feed audience and sources",
      "shape": "service",
      "flags": []
    },
    {
      "id": "feed-fanout",
      "name": "Feed Fanout Worker",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Fans normal posts to follower caches, skips celebrity posts",
      "why": "Avoids 1M+ writes per celebrity post",
      "shape": "worker",
      "flags": [
        {
          "intent": "Feed Fanout Worker fans normal posts to follower caches, skips celebrity posts - fanout-on-write-except-celebrity-over-1M",
          "difference": "on_post fans out to all followers with no celebrity follower-count check, performing 1M+ cache writes per celebrity post instead of skipping fanout for celebrity posts over 1M for merge-on-read"
        }
      ]
    },
    {
      "id": "feed-ranker",
      "name": "Feed Ranking Service",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Merges cached feed with celebrity posts at read time and ranks",
      "why": "Serves celebrity posts fresh without fanout blowup",
      "shape": "service",
      "flags": []
    },
    {
      "id": "post-store",
      "name": "Post Store",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Persists post content durably",
      "why": "Source of truth for posts",
      "shape": "store",
      "flags": []
    },
    {
      "id": "feed-cache",
      "name": "Feed Cache",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Holds precomputed per-user feeds",
      "why": "Serves ranked reads with low latency",
      "shape": "cache",
      "flags": []
    },
    {
      "id": "feed-lists",
      "name": "Feed List Storage",
      "kind": "module",
      "parentId": "feed-cache",
      "what": "Stores ordered post IDs per user",
      "why": "Serve candidate fetch in single shard lookup",
      "shape": "cache",
      "notes": [
        "sorted-set per userId key, member postId score publish-time",
        "sharded by hash(userId), replication factor 3 per shard",
        "trims to top ~1000 entries per user, paginated read by ZRANGE",
        "hot users pinned in memory, cold users on SSD tier"
      ],
      "flags": []
    },
    {
      "id": "feed-ingest",
      "name": "Fanout Ingest Path",
      "kind": "module",
      "parentId": "feed-cache",
      "what": "Absorbs fanout pushes into lists",
      "why": "Protect read latency from write bursts",
      "shape": "service",
      "notes": [
        "batches fanout pushes per destination shard",
        "dedups repeat postId per user list",
        "backpressures fanout worker on queue full"
      ],
      "flags": []
    },
    {
      "id": "feed-eviction",
      "name": "Expiry and Eviction Policy",
      "kind": "module",
      "parentId": "feed-cache",
      "what": "Enforces TTL and LRU eviction",
      "why": "Bound memory while keeping hit rate high",
      "shape": "worker",
      "notes": [
        "TTL ~days plus LRU on memory pressure",
        "lazy expiry on read plus background scan",
        "never evicts pinned hot celebrity-follower lists first"
      ],
      "flags": []
    },
    {
      "id": "media-store",
      "name": "Media Blob Store",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Stores image and video blobs, returns URL",
      "why": "Keeps large media out of Post Store",
      "shape": "store",
      "flags": []
    },
    {
      "id": "media-cdn",
      "name": "Media CDN",
      "kind": "component",
      "parentId": "fb-newsfeed",
      "what": "Caches and delivers media bytes at edge",
      "why": "Offloads media reads and cuts playback latency",
      "shape": "gateway",
      "flags": []
    },
    {
      "id": "rank-merge",
      "name": "Candidate Merger",
      "kind": "module",
      "parentId": "feed-ranker",
      "what": "Merges cached feed IDs with fresh celebrity posts",
      "why": "Combine fanout and non-fanned sources in one set",
      "shape": "service",
      "notes": [
        "keys: userId -> cached IDs + celebrity author IDs",
        "pulls celeb posts from post-store on read, no fanout",
        "fan-in: feed-lists read + post details fetch",
        "dedups by postId before filter"
      ],
      "flags": []
    },
    {
      "id": "rank-filter",
      "name": "Visibility Filter",
      "kind": "module",
      "parentId": "feed-ranker",
      "what": "Removes ineligible and duplicate posts",
      "why": "Enforce privacy and quality before ranking",
      "shape": "service",
      "notes": [
        "drops blocked, hidden, deleted, out-of-privacy posts",
        "checks author privacy against social-graph rules",
        "runs before scoring to save rank compute",
        "stateless, fail-closed on privacy-check error"
      ],
      "flags": []
    },
    {
      "id": "rank-scoring",
      "name": "Relevance Scorer",
      "kind": "module",
      "parentId": "feed-ranker",
      "what": "Orders visible candidates by relevance score",
      "why": "Show most engaging posts first",
      "shape": "service",
      "notes": [
        "scores by recency, affinity, engagement features",
        "top-K sort, K=page size ~20-50",
        "hot-path budget part of p99<200ms feed read",
        "falls back to chronological on scorer timeout"
      ],
      "flags": []
    }
  ],
