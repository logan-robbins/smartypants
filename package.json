{
  "name": "@logan-robbins/smartypants",
  "version": "0.2.0",
  "type": "module",
  "description": "Live Mermaid-style system diagram, compact IntentCode memory, and intent-drift flags for coding agents. Jev-style triage; Meta Muse Spark by default.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logan-robbins/smartypants.git"
  },
  "license": "Apache-2.0",
  "bin": {
    "smartypants": "./bin/smartypants.mjs",
    "smartypants-hook": "./bin/smartypants-hook.mjs",
    "smartypants-serve": "./bin/smartypants-serve.mjs",
    "smartypants-worker": "./bin/smartypants-worker.mjs"
  },
  "exports": {
    ".": "./src/pipeline.js",
    "./pi": "./src/pi-extension.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    "examples",
    "smartypants.config.example.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CITATION.cff",
    "docs/*.md"
  ],
  "scripts": {
    "test": "node --test",
    "hook": "node bin/smartypants-hook.mjs",
    "serve": "node bin/smartypants-serve.mjs",
    "eval": "node eval/run.mjs",
    "eval:triage": "node eval/triage.mjs",
    "eval:turnend": "node eval/turnend.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@openai/agents": "^0.18.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "keywords": [
    "architecture",
    "diagram",
    "mermaid",
    "system-design",
    "intent",
    "drift",
    "claude-code",
    "codex",
    "pi-package",
    "meta",
    "jev"
  ],
  "pi": {
    "extensions": [
      "./src/pi-extension.js"
    ],
    "skills": [
      "./plugins/smartypants/skills"
    ]
  },
  "author": {
    "name": "Logan Robbins",
    "url": "https://github.com/logan-robbins"
  },
  "homepage": "https://logan-robbins.github.io/smartypants/",
  "bugs": {
    "url": "https://github.com/logan-robbins/smartypants/issues"
  }
}
